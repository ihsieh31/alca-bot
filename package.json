{
  "name": "alca-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Alca Agent (codename) — local-first, privacy-first personal agent OS",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/ui/tsconfig.json && tsc -p apps/phone-pwa/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "evals": "node --disable-warning=ExperimentalWarning packages/evals/src/main.ts",
    "evals:live": "node --disable-warning=ExperimentalWarning packages/evals/src/live.ts",
    "check:size": "node scripts/check-file-size.ts",
    "spec:gen": "node packages/protocol/scripts/gen-schema.ts",
    "spec:check": "node packages/protocol/scripts/gen-schema.ts --check",
    "check": "pnpm typecheck && pnpm lint && pnpm check:size && pnpm check:deploy-values && pnpm check:versions && pnpm check:names && pnpm check:prompt-budget && pnpm check:i18n && pnpm spec:check && pnpm test",
    "desktop": "node --disable-warning=ExperimentalWarning apps/desktop/src/main.ts",
    "desktop:demo": "node --disable-warning=ExperimentalWarning apps/desktop/src/main.ts --engine demo --data-dir .alca-dev --composio-mock",
    "desktop:pair": "node --disable-warning=ExperimentalWarning apps/desktop/src/pair.ts",
    "rendezvous": "node --disable-warning=ExperimentalWarning services/rendezvous/src/main.ts",
    "hands": "node --disable-warning=ExperimentalWarning apps/hands/src/main.ts",
    "screenshots": "node --disable-warning=ExperimentalWarning apps/desktop/scripts/screenshot.ts",
    "screenshots:p6": "ALCA_SHOTS_ONLY=p6 node --disable-warning=ExperimentalWarning apps/desktop/scripts/screenshot.ts docs/screenshots",
    "alca": "node --disable-warning=ExperimentalWarning apps/desktop/src/cli.ts",
    "check:deploy-values": "node scripts/check-deploy-values.ts",
    "check:versions": "node scripts/check-versions.ts",
    "check:names": "node scripts/check-names.ts",
    "check:prompt-budget": "node --disable-warning=ExperimentalWarning scripts/check-prompt-budget.ts",
    "check:i18n": "node --disable-warning=ExperimentalWarning scripts/check-i18n.ts",
    "i18n:extract": "node --disable-warning=ExperimentalWarning scripts/i18n-extract.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
